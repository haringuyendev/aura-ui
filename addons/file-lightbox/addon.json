{
  "name": "file-lightbox",
  "summary": "Full-screen viewer for images, PDF (react-pdf), Word .docx (docx-preview), Excel/CSV (SheetJS) and text, each viewer lazy-loaded.",
  "dependencies": {
    "react-pdf": "^11.0.0",
    "docx-preview": "^0.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "assets": [
    {
      "from": "node_modules/pdfjs-dist/cmaps",
      "to": "public/pdfjs/cmaps"
    },
    {
      "from": "node_modules/pdfjs-dist/standard_fonts",
      "to": "public/pdfjs/standard_fonts"
    },
    {
      "from": "node_modules/pdfjs-dist/wasm",
      "to": "public/pdfjs/wasm"
    }
  ]
}
